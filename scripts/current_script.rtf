###### E. Combine results from interaction design -----\
\
# Convert each results object to data.frame and add gene column\
res_list <- list(\
  timepoint_neg = timepoint_effect_12W_vs_6W_at_myc_neg.IHW.ashr,\
  timepoint_pos = timepoint_effect_12W_vs_6W_at_myc_pos.IHW.ashr,\
  myc_6W = myc_effect_6W.IHW.ashr,\
  myc_12W = myc_effect_12W.IHW.ashr,\
  interaction = myc_effect_12W_vs_6W.IHW.ashr\
)\
\
# Convert and name each one\
res_df_list <- lapply(names(res_list), function(name) \{\
  df <- as.data.frame(res_list[[name]])\
  df$gene <- rownames(df)\
  df <- df[, c("gene", "padj", "log2FoldChange")]\
  colnames(df)[2:3] <- paste0(name, c("_padj", "_log2FC"))\
  df\
\})\
\
# Merge all into one data frame\
combined_df <- Reduce(function(x, y) full_join(x, y, by = "gene"), res_df_list)\
\
\
\
\
\
\
\
# annonate genes by gene name\
mart <- useMart("ensembl", dataset = "mmusculus_gene_ensembl")\
\
# Extract unique Ensembl gene IDs from your combined DESeq2 result table\
ensembl_ids <- unique(combined_df$gene)\
\
# 3. Query MGI symbols for those Ensembl IDs\
gene_annotations <- getBM(\
  attributes = c("ensembl_gene_id", "mgi_symbol"), \
  filters = "ensembl_gene_id", \
  values = ensembl_ids, \
  mart = mart\
)\
\
# 4. Merge gene symbols into combined_df\
combined_df_annotated <- combined_df %>%\
  left_join(gene_annotations, by = c("gene" = "ensembl_gene_id"))\
combined_df_annotated <- combined_df_annotated %>%\
  relocate(mgi_symbol, .after = gene)\
\
