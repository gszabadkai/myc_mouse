) %>%\
  as.data.frame() %>%\
  rownames_to_column("gene") %>%\
  dplyr::select(gene, interaction_log2FC_shrunk = log2FoldChange, interaction_padj_shrunk = padj)\
\
\
# Merge into combined_df_annotated and classify\
combined_df_annotated <- combined_df_annotated %>%\
  left_join(interaction_res_raw, by = "gene") %>%\
  left_join(interaction_res_shrunk, by = "gene") %>%\
  mutate(\
    time_effect_category_raw = case_when(\
      is.na(interaction_log2FC_raw) ~ "no_data",\
      interaction_padj_raw < 0.1 & interaction_log2FC_raw < -0.5 & abs(timepoint_neg_log2FC) < 0.3 ~ "direct_MYC_reduction",\
      interaction_padj_raw < 0.1 & interaction_log2FC_raw < -0.5 & timepoint_neg_log2FC < -0.3 ~ "mixed_baseline_and_MYC",\
      interaction_padj_raw < 0.1 & interaction_log2FC_raw > 0.5 ~ "MYC_effect_increases",\
      interaction_padj_raw >= 0.1 & abs(timepoint_pos_log2FC - timepoint_neg_log2FC) < 0.3 ~ "baseline_driven",\
      TRUE ~ "ambiguous"\
    ),\
    time_effect_category_shrunk = case_when(\
      is.na(interaction_log2FC_shrunk) ~ "no_data",\
      interaction_padj_shrunk < 0.1 & interaction_log2FC_shrunk < -0.5 & abs(timepoint_neg_log2FC) < 0.3 ~ "direct_MYC_reduction",\
      interaction_padj_shrunk < 0.1 & interaction_log2FC_shrunk < -0.5 & timepoint_neg_log2FC < -0.3 ~ "mixed_baseline_and_MYC",\
      interaction_padj_shrunk < 0.1 & interaction_log2FC_shrunk > 0.5 ~ "MYC_effect_increases",\
      interaction_padj_shrunk >= 0.1 & abs(timepoint_pos_log2FC - timepoint_neg_log2FC) < 0.3 ~ "baseline_driven",\
      TRUE ~ "ambiguous"\
    )\
  )\
\
combined_df_annotated %>%\
  count(time_effect_category_raw)\
\
\
