# ...2. Generate heatmaps ----\
\
# function:\
\
generate_heatmaps_for_gene_set <- function(\
    set_name,\
    gene_symbols,\
    dds_obj,\
    lfc_df,\
    lfc_columns = c("myc_6W_log2FC", "timepoint_neg_log2FC", "myc_12W_log2FC", "timepoint_pos_log2FC"),\
    output_dir = "outputs/heatmaps_int/",\
    show_plot = TRUE\
) \{\
  # Load required libraries\
  require(ComplexHeatmap)\
  require(circlize)\
  require(dplyr)\
  require(tibble)\
  select <- dplyr::select\
  \
  if (!dir.exists(output_dir)) dir.create(output_dir, recursive = TRUE)\
  \
  # Step 1: log2FC matrix\
  lfc_mat <- lfc_df %>%\
    filter(mgi_symbol %in% gene_symbols) %>%\
    select(mgi_symbol, all_of(lfc_columns)) %>%\
    column_to_rownames("mgi_symbol") %>%\
    as.matrix()\
  if (nrow(lfc_mat) == 0) \{\
    warning(paste("No genes found for set:", set_name))\
    return(NULL)\
  \}\
  \
  # Step 2: Normalized expression matrix\
  norm_counts <- counts(dds_obj, normalized = TRUE)\
  log_expr <- log2(norm_counts + 1)\
  gene_map <- lfc_df %>% select(gene, mgi_symbol) %>% distinct()\
  log_expr <- log_expr[rownames(log_expr) %in% gene_map$gene, ]\
  rownames(log_expr) <- gene_map$mgi_symbol[match(rownames(log_expr), gene_map$gene)]\
  log_expr <- log_expr[!is.na(rownames(log_expr)), ]\
  \
  # Step 3: Group averaging\
  coldata <- as.data.frame(colData(dds_obj))\
  group_levels <- levels(coldata$group)\
  group_means <- sapply(group_levels, function(g) \{\
    samples <- rownames(coldata)[coldata$group == g]\
    rowMeans(log_expr[, samples, drop = FALSE])\
  \})\
  rownames(group_means) <- rownames(log_expr)\
  \
  # Step 4: Filter and align\
  common_genes <- intersect(rownames(lfc_mat), rownames(group_means))\
  if (length(common_genes) == 0) \{\
    warning(paste("No overlapping genes in expression data for set:", set_name))\
    return(NULL)\
  \}\
  lfc_mat <- lfc_mat[common_genes, , drop = FALSE]\
  expr_mat <- group_means[common_genes, , drop = FALSE]\
  expr_mat <- expr_mat[apply(expr_mat, 1, function(x) length(unique(x)) > 1), , drop = FALSE]\
  lfc_mat <- lfc_mat[rownames(expr_mat), , drop = FALSE]\
  if (nrow(expr_mat) == 0) \{\
    warning(paste("Expression matrix empty after filtering for set:", set_name))\
    return(NULL)\
  \}\
  \
  # Step 5: Final formatting\
  lfc_mat <- lfc_mat[order(rownames(lfc_mat)), , drop = FALSE]\
  expr_mat <- expr_mat[order(rownames(expr_mat)), , drop = FALSE]\
  expr_mat <- expr_mat[, c("6W_neg", "6W_pos", "12W_neg", "12W_pos")]\
  expr_scaled <- t(scale(t(expr_mat)))\
  \
  # Step 6: Save to PDF\
  safe_name <- gsub("[/\\\\|:*?\\"<>]", "_", set_name)\
  pdf_path <- file.path(output_dir, paste0(safe_name, ".pdf"))\
  pdf(pdf_path, width = 5, height = 10)\
  grid::grid.newpage()\
  \
  ht1 <- Heatmap(\
    lfc_mat,\
    name = "log2FC",\
    cluster_rows = TRUE,\
    cluster_columns = FALSE,\
    column_order = lfc_columns,\
    show_column_names = TRUE,\
    show_row_names = TRUE,\
    cell_fun = function(j, i, x, y, ...) \{\
      grid.text(sprintf("%.2f", lfc_mat[i, j]), x, y, gp = gpar(fontsize = 8))\
    \}\
  )\
  \
  ht2 <- Heatmap(\
    expr_scaled,\
    name = "log2norm",\
    cluster_rows = FALSE,\
    cluster_columns = FALSE,\
    column_order = colnames(expr_scaled),\
    show_column_names = TRUE,\
    show_row_names = FALSE,\
    cell_fun = function(j, i, x, y, ...) \{\
      grid.text(sprintf("%.2f", expr_mat[i, j]), x, y, gp = gpar(fontsize = 8))\
    \}\
  )\
  \
  draw(ht1 + ht2, merge_legend = TRUE)\
  dev.off()\
  \
  # Step 7: Optional on-screen display\
  if (show_plot) \{\
    grid::grid.newpage()\
    draw(ht1 + ht2, merge_legend = TRUE)\
  \}\
  \
  return(pdf_path)\
\}\
\
\
